<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GboardCasual"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#EDEDED" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Casual tone for Gboard Translate"
            android:textSize="13sp"
            android:textColor="#808080" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:padding="14dp"
            android:background="@drawable/card_bg">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Status"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#8CE8B0" />
            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="loading..."
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:textColor="#EDEDED" />
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:padding="14dp"
            android:background="@drawable/card_bg">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Compatibility"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#8CE8B0" />
            <TextView
                android:id="@+id/compat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="checking..."
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:textColor="#EDEDED" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Gboard updates can rename its internals and silently stop rewrites. After any Gboard update: translate once, then check the hook log for gate watch skipped. Extra gates attach without a rebuild via gate=Class:method lines."
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"
                android:textColor="#808080" />
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:padding="14dp"
            android:background="@drawable/card_bg">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Voice"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#8CE8B0" />
            <Switch
                android:id="@+id/sw_enabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:checked="true"
                android:text="Enabled (mode=1)"
                android:textColor="#EDEDED" />
            <RadioGroup
                android:id="@+id/rg_style"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp">
                <RadioButton
                    android:id="@+id/rb_kamu"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="kamu / aku"
                    android:textColor="#EDEDED" />
                <RadioButton
                    android:id="@+id/rb_lu"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="lu / gw"
                    android:textColor="#EDEDED" />
            </RadioGroup>
            <Switch
                android:id="@+id/sw_slang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Street slang (slang=1)"
                android:textColor="#EDEDED" />
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:padding="14dp"
            android:background="@drawable/card_bg">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Guards"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#8CE8B0" />
            <Switch
                android:id="@+id/sw_auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:checked="true"
                android:text="Formal-mail guard (auto=1)"
                android:textColor="#EDEDED" />
            <Switch
                android:id="@+id/sw_spy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:checked="true"
                android:text="Verbose hook log (spy=1)"
                android:textColor="#EDEDED" />
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:padding="14dp"
            android:background="@drawable/card_bg">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Custom pairs"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#8CE8B0" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Formal=casual, one per line, any language"
                android:textSize="12sp"
                android:textColor="#808080" />
            <EditText
                android:id="@+id/et_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="4"
                android:gravity="top"
                android:padding="10dp"
                android:background="#121212"
                android:inputType="textMultiLine"
                android:hint="Vous=tu&#10;Usted=tú"
                android:textColor="#FFFFFF"
                android:textColorHint="#808080" />
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:padding="14dp"
            android:background="@drawable/card_bg">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Flexible pass (reserved)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#8CE8B0" />
            <Switch
                android:id="@+id/sw_llm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="LLM pass (llm=1)"
                android:textColor="#EDEDED" />
            <EditText
                android:id="@+id/et_endpoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:padding="10dp"
                android:background="#121212"
                android:singleLine="true"
                android:inputType="textUri"
                android:hint="endpoint=http://127.0.0.1:PORT/paraphrase"
                android:textColor="#FFFFFF"
                android:textColorHint="#808080" />
            <EditText
                android:id="@+id/et_target"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:padding="10dp"
                android:background="#121212"
                android:singleLine="true"
                android:inputType="text"
                android:hint="target=en"
                android:textColor="#FFFFFF"
                android:textColorHint="#808080" />
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Save"
                android:textColor="#EDEDED" />
            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />
            <Button
                android:id="@+id/btn_refresh"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Refresh"
                android:textColor="#EDEDED" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/btn_kill"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Kill Gboard"
                android:textColor="#EDEDED" />
            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />
            <Button
                android:id="@+id/btn_root"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Check root"
                android:textColor="#EDEDED" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Save and Kill need root: allow GboardCasual in KernelSU manager, Superuser tab. LSPosed scope stays Gboard only."
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:textColor="#808080" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="by @noticesa · Telegram"
            android:textSize="12sp"
            android:textColor="#808080" />

    </LinearLayout>
</ScrollView>
